generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  createdAt     DateTime  @default(now())

  exercises     Exercise[]
  goals         Goal[]

  // Gamification
  xp            Int       @default(0)
  level         Int       @default(1)
  streak        Int       @default(0)
  lastActive    DateTime  @default(now())
}

model Exercise {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])

  subject       String    // Titre du sujet
  briefContent  String    // Plan généré
  mediaType     String    // "audio" | "video"
  mediaUrl      String    // Path vers fichier
  duration      Int       // Durée en secondes

  // Scores
  globalScore   Float
  wordsPerMin   Int
  fillerWords   Int
  pausesAvg     Float
  clarity       Float

  // Analysis
  mainStrength  String
  mainWeakness  String
  recommendation String
  timestamps    String    // JSON avec markers

  createdAt     DateTime  @default(now())
}

model Goal {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])

  description   String
  targetValue   Float
  currentValue  Float
  completed     Boolean   @default(false)

  createdAt     DateTime  @default(now())
}
